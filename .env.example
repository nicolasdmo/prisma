# ── Site ────────────────────────────────────────────────────────
# Canonical public URL (OG tags, sitemap, MercadoPago back_urls).
# Falls back to https://prisma-v2-six.vercel.app if unset.
NEXT_PUBLIC_BASE_URL=https://prisma-v2-six.vercel.app

# Google Analytics 4 measurement id (falls back to the hardcoded prod id).
NEXT_PUBLIC_GA_ID=G-47KBVB1F4L

# ── Auth (NextAuth v5 + Google) ─────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Supabase ────────────────────────────────────────────────────
# NOTE: these are the names the code actually reads (lib/supabase.ts /
# lib/supabaseAdmin.ts) — NOT the NEXT_PUBLIC_SUPABASE_* convention.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ── MercadoPago ─────────────────────────────────────────────────
MP_ACCESS_TOKEN=
# HMAC secret from the MP webhook config. REQUIRED in production —
# the webhook rejects unsigned requests when NODE_ENV=production.
MP_WEBHOOK_SECRET=
# Price in ARS. Optional — defaults to PRICE_AMOUNT in lib/config.ts.
MP_PRICE=9999
MP_CURRENCY=ARS

# ── Rate limiting (opcional) ────────────────────────────────────
# Si seteás estas dos, el rate limiting pasa a ser global (Upstash Redis
# via REST). Sin ellas, usa el fallback in-memory por instancia.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
