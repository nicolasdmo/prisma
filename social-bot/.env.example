# ============================================================
# SOCIAL MEDIA AUTO-POST BOT - Configuración de credenciales
# Copia este archivo como .env y completa tus valores
# ============================================================

PORT=3000

# ── META (Facebook + Instagram) ──────────────────────────────
# Obtén estas credenciales en: https://developers.facebook.com
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=               # ID de tu Facebook Page
META_PAGE_ACCESS_TOKEN=     # Token de la página (long-lived)
META_IG_USER_ID=            # ID de cuenta de Instagram Business

# ── X / TWITTER ──────────────────────────────────────────────
# Obtén estas credenciales en: https://developer.twitter.com
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=

# ── TIKTOK ───────────────────────────────────────────────────
# Obtén estas credenciales en: https://developers.tiktok.com
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

# ── YOUTUBE ──────────────────────────────────────────────────
# Obtén estas credenciales en: https://console.cloud.google.com
# Habilita "YouTube Data API v3"
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
